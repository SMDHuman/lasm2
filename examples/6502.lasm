
<# IMM; 0#>
<# ZP ; 1#>
<# ZPX; 2#>
<# AB ; 3#>
<# ABX; 4#>
<# ABY; 5#>
<# INX; 6#>
<# INY; 7#>

<# ADDR_MODE_IMM val; (val)$1#>
<# ADDR_MODE_ZP  val; (val)$1#>
<# ADDR_MODE_ZPX val; (val)$1#>
<# ADDR_MODE_AB  val; (val)$2#>
<# ADDR_MODE_ABX val; (val)$2#>
<# ADDR_MODE_ABY val; (val)$2#>
<# ADDR_MODE_INX val; (val)$1#>
<# ADDR_MODE_INY val; (val)$1#>

<# ADC | adc; #>
<# AND | and; #>
<# ASL | asl; #>
<# BCC | bcc; #>
<# BCS | bcs; #>
<# BEQ | beq; #>
<# BIT | bit; #>
