<#A; 0x100#>
<#B; 0x200#>
<#MEM; 0x300#>

<# MOV out, in1 
(((out) << 6)&0xff) | (0 << 3) | (in1)>>8
(in1) < 256 ? (in1) : _
#>


<#LDA_I imm
(1 << 6) |  0; (imm)$2
#>

<#LDB_I imm
(2 << 6) |  0; (imm)$2
#>

<#LDA in2
(1 << 6) | (0 << 3) | (in2)>>8 | 3
(in2) < 256 ? (in2) : _
#>

<#LDB in2
(2 << 6) | (0 << 3) | (in2)>>8 | 3
(in2) < 256 ? (in2) : _
#>

<#STA in2
(3 << 6) | (0 << 3) | (in2)>>8 | 1
(in2) < 256 ? (in2) : _
#>

<#STB in2
(3 << 6) | (0 << 3) | (in2)>>8 | 2
(in2) < 256 ? (in2) : _
#>

<#TBA
(1 << 6) | (0 << 3) |  2
#>

<#TAB
(2 << 6) | (0 << 3) |  1
#>

<# ADC in1, in2, out 
(out << 6) | (3 << 3) | (in2)>>6 | (in1)>>8 
(in1) < 256 ? (in1) : ((in2) < 256 ? (in2) : _)
#>

<# SUB in1, in2, out 
(out << 6) | (4 << 3) | (in2)>>6 | (in1)>>8 
(in1) < 256 ? (in1) : ((in2) < 256 ? (in2) : _)
#>

<# OR in1, in2, out 
(out << 6) | (5 << 3) | (in2)>>6 | (in1)>>8 
(in1) < 256 ? (in1) : ((in2) < 256 ? (in2) : _)
#>

<# AND in1, in2, out 
(out << 6) | (6 << 3) | (in2)>>6 | (in1)>>8 
(in1) < 256 ? (in1) : ((in2) < 256 ? (in2) : _)
#>

<# XOR in1, in2, out;
(out << 6) | (7 << 3) | (in2)>>6 | (in1)>>8 
(in1) < 256 ? (in1) : ((in2) < 256 ? (in2) : _)
#>

ADC 55, A, A
ADC 55, a, a