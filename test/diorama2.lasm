<#A; 0x100#>
<#B; 0x200#>
<#MEM; 0x300#>

<#OP_MOV; (0 << 3)#>

<# MOV out, in1 
(((out) << 6)&0xff) | OP_MOV | (in1)>>8
(in1) < 256 ? (in1) : _
#>

<#LDA_I imm
(1 << 6) |  0; (imm)$2
#>

<#LDB_I imm
(2 << 6) |  0; (imm)$2
#>

<#LDA in2
(1 << 6) | OP_MOV | (in2)>>8 | 3
(in2) < 256 ? (in2) : _
#>

<#LDB in2
(2 << 6) | OP_MOV | (in2)>>8 | 3
(in2) < 256 ? (in2) : _
#>

<#STA in2
(3 << 6) | OP_MOV | (in2)>>8 | 1
(in2) < 256 ? (in2) : _
#>

<#STB in2
(3 << 6) | OP_MOV | (in2)>>8 | 2
(in2) < 256 ? (in2) : _
#>

<#TBA
(1 << 6) | OP_MOV |  2
#>

<#TAB
(2 << 6) | OP_MOV |  1
#>

<# ADC out, in1, in2 
((out >> 2) | (3 << 3) | (in2)>>6 | (in1)>>8)$1
(in1) < 256 ? (in1) : ((in2) < 256 ? (in2) : _)
#>

<# SUB out, in1, in2 
((out >> 2) | (4 << 3) | (in2)>>6 | (in1)>>8)$1
(in1) < 256 ? (in1) : ((in2) < 256 ? (in2) : _)
#>

<# OR out, in1, in2 
((out >> 2) | (5 << 3) | (in2)>>6 | (in1)>>8)$1
(in1) < 256 ? (in1) : ((in2) < 256 ? (in2) : _)
#>

<# AND out, in1, in2 
((out >> 2) | (6 << 3) | (in2)>>6 | (in1)>>8)$1
(in1) < 256 ? (in1) : ((in2) < 256 ? (in2) : _)
#>

<# XOR out, in1, in2
((out >> 2) | (7 << 3) | (in2)>>6 | (in1)>>8)$1
(in1) < 256 ? (in1) : ((in2) < 256 ? (in2) : _)
#>

<#JMP address
{ 
  .here;
  ( 0 | OP_MOV | 0)$1
  (here - address)$1
}
#>


.start[16]
  ADC A, 0x55, A
  JMP end
  
.end[32]