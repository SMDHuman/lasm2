// INCLUDE - insert entire code from file
//<#"macro_include.la"#>
// DEFINE - whenever assembler sees 'recall_name', it replaces with definition
<#recall_name; 0xfa 0xfb#>
recall_name; recall_name; recall_name;

// DEFINE WITH ARGS - positional arguments 
<#recall_name_args a, b, c;
  0xffffff; 0; a; b; c; 0
#>
recall_name_args 1, 2, 3 

// IF DEFINE - controller for macro parser to enable or block code
<#this;0xabc#>
<#? this; recall_name; 0x2
#>      // if 'this' is defined
<#! that; 0x3; recall_name;
#>    // if 'that' not defined


<#thats; 88#>
<#X; recall_name; 123; <#Y; 5#>#>

<#HOME|home is; "home"; is ;"home"#>

HOME "this"; 
this;
home "is";
// ADC x, y;
// LDA 3
// TBA; TAB;

<#multi_arg_test a;
  "1"; a
#>
<#multi_arg_test a, b;
  "2"; a; b
#>
<#multi_arg_test a, b, c;
  "3"; a; b; c
#>

multi_arg_test "a"
multi_arg_test "a", "b"
multi_arg_test "a", "b", "c"