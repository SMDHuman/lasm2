// INCLUDE - insert entire code from file
<"blank.la">

// DEFINE - whenever assembler sees 'recall_name', it replaces with definition
<recall_name 0xfa>
recall_name; recall_name; recall_name

// DEFINE WITH ARGS - positional arguments 
<recall_name (<arg_name>, <another_arg>)
  0x00; <arg_name>; 0x00; <another_arg>
>
recall_name (0xfc, 0xfd)

// IF DEFINE - controller for macro parser to enable or block code
<?this can do this>      // if 'this' is defined
<!that <that 0xfe>>    // if 'that' not defined

<?(zp == 0) do that> // if expression with in parantesis is evaluatable and corrent
<!(zp == 0) do that> // if expression with in parantesis is non-evaluatable at the time or uncorrect
// ==, !=, >=, <=, >, < 

//<ERROR Somethings>
<WARNING Otherthings>
<LOG Thisthings>

<ADC_I <i>; 0x69; <i>>
<ADC <ad>
  <?(#<ad> == 1) 0x65; <ad>
  <?(#<ad> == 2) 0x6D; <ad>#2
  <?(#<ad> > 2) <ERROR address is too log>
>
<ADC_X <ad>; 
  <?(#<ad> == 1) 0x75; <ad>
  <?(#<ad> == 2) 0x7D; <ad>#2
  <?(#<ad> > 2) <ERROR address is too log>
>
<ADC_Y <ad>; 0x79; <ad>#2>
<ADC_IX <ad>; 0x61; <ad>#2>
<ADC_IY <ad>; 0x71; <ad>#2>
